# Optional. Default transcription and offline translation need no API key.
# Setup and the settings page persist the choice in .nimdaydu/asr-model.json.
# This environment value applies only when no saved choice exists.
NIMDAYDU_MODEL=hybrid
# Faster on this Intel laptop in the included benchmark. Set 0 to compare.
MOONSHINE_ORT_SINGLE_THREAD=1
# DEEPSEEK_API_KEY=your-key-here
# DEEPSEEK_MODEL=deepseek-flash
